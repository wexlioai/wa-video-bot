# Copy to .env in this folder (used by both docker-compose and the orchestrator):  cp .env.example .env

# --- orchestrator ---
PORT=3000
# long random string: openssl rand -hex 24
WEBHOOK_SECRET=change-me-to-a-long-random-string
# how the Evolution container reaches this service
SELF_URL=http://host.docker.internal:3000

# --- WhatsApp / Evolution API ---
EVO_URL=http://127.0.0.1:8080
# long random string, also used by docker-compose
EVO_API_KEY=change-me-too
EVO_INSTANCE=videobot
# your WhatsApp number with country code, digits only
OWNER_NUMBER=923001234567
# true  = Evolution is linked to YOUR number; you talk to the bot in "Message yourself"
# false = Evolution is linked to a second number; you message that number
SELF_CHAT=true

# --- Voice ---
# edge = free Microsoft neural voices (edge-tts, no key) | openspeaker | elevenlabs
TTS_PROVIDER=edge
# speaking speed for edge voices, e.g. -8% slower, +8% faster
TTS_RATE=+0%
# python with edge-tts installed (installers create .venv in the project folder)
# PYTHON_BIN=
# voices as id:Name (edge ids like ur-PK-UzmaNeural; ElevenLabs voice ids)
VOICES_UR=ur-PK-AsadNeural:Asad,ur-PK-UzmaNeural:Uzma,ur-IN-SalmanNeural:Salman,ur-IN-GulNeural:Gul
VOICES_EN=en-US-AndrewMultilingualNeural:Andrew,en-US-AvaMultilingualNeural:Ava,en-US-BrianMultilingualNeural:Brian,en-GB-RyanNeural:Ryan

# --- OpenSpeaker (only if TTS_PROVIDER=openspeaker) ---
# key: openspeaker.ai/app/api-document -> "API Key". Voice ids have a provider prefix, e.g. elevenlabs_xxx, edge_ur-PK-UzmaNeural
OPENSPEAKER_API_KEY=
# 0.5 - 1.5
OPENSPEAKER_SPEED=1

# --- ElevenLabs (only if TTS_PROVIDER=elevenlabs) ---
ELEVEN_API_KEY=sk_...
ELEVEN_MODEL=eleven_v3
# length of each voice sample in characters (keeps credit use low)
SAMPLE_CHARS=260

# --- Claude Code (uses your Claude subscription; do NOT set ANTHROPIC_API_KEY) ---
CLAUDE_BIN=claude
# optional: sonnet / opus. Empty = Claude Code default. Sonnet saves plan limit.
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_MIN=15

# --- rendering ---
RENDER_CONCURRENCY=3
CAPTIONS=true

# --- YouTube ---
# browser = headless Chromium drives YouTube Studio with your saved login (default, no Google Cloud needed)
# api     = YouTube Data API (needs the YT_CLIENT_* / YT_REFRESH_TOKEN below; forced private if unverified)
YT_METHOD=browser
# saved login from `npm run yt:login` (default: data/yt-session.json)
# YT_SESSION_FILE=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private | unlisted | public   (browser mode can publish public directly)
YT_PRIVACY=public
YT_CATEGORY=27
